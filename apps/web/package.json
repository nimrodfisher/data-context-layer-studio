{
  "name": "@context-layer/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "contracts:build": "corepack pnpm --filter @context-layer/core build && corepack pnpm --filter @context-layer/sources build && corepack pnpm --filter @context-layer/agent build && corepack pnpm --filter @context-layer/exporters build",
    "predev": "corepack pnpm run contracts:build",
    "dev": "next dev",
    "prebuild": "corepack pnpm run contracts:build",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "corepack pnpm run contracts:build",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@context-layer/agent": "workspace:*",
    "@context-layer/core": "workspace:*",
    "@context-layer/exporters": "workspace:*",
    "@context-layer/sources": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3"
  }
}
