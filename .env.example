NEXT_PUBLIC_APP_NAME=Context Layer Studio

# Claude Code CLI (used on Review → Build skill with Claude Code)
# Leave unset to resolve `claude` / `claude.cmd` from PATH.
# CONTEXT_LAYER_CLAUDE_BIN=C:\Users\Lenovo\AppData\Local\Claude\claude.exe

# Optional: local OpenAI-compatible agent (Ollama, LM Studio, local gateway)
# Enables richer interview rephrasing + grounded drafting. Interview works without these.
# Skill polish uses Claude Code, not this provider.
# CONTEXT_LAYER_AI_BASE_URL=http://127.0.0.1:11434/v1
# CONTEXT_LAYER_AI_MODEL=llama3.2
# CONTEXT_LAYER_AI_API_KEY_REF=CONTEXT_LAYER_AI_API_KEY
# CONTEXT_LAYER_AI_API_KEY=ollama
# CONTEXT_LAYER_AI_ALLOWED_HOSTS=127.0.0.1,localhost
# CONTEXT_LAYER_AI_ALLOW_PRIVATE=true

# Optional: fixed local workspace for project.json and Claude build packs
# CONTEXT_LAYER_WORKSPACE=C:\Users\Lenovo\context_layer_onboarding\.context-layer-data
