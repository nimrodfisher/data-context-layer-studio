{
  "name": "context-layer-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @context-layer/web dev",
    "build": "corepack pnpm --filter @context-layer/web build",
    "lint": "eslint .",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "pretest": "corepack pnpm --filter @context-layer/core build && corepack pnpm --filter @context-layer/sources build && corepack pnpm --filter @context-layer/agent build && corepack pnpm --filter @context-layer/exporters build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
