    "verifiedQueries": [
      {
        "id": "query-t1",
        "name": "trial_to_paid_by_plan",
        "sql": "SELECT PLAN_TIER, COUNT_IF(converted) / COUNT(*) AS conversion FROM trial_cohort WHERE IS_INTERNAL = FALSE GROUP BY 1",
        "metricIds": ["metric-trial-conversion"],
        "assetIds": ["asset-fact-cycle", "asset-dim-member"],
        "evidenceIds": ["ev-conversion-def"],
        "signed": { "state": "signed", "history": [{ "action": "signed", "ownerId": "owner-dana", "at": "2026-07-18T09:00:00.000Z" }] },
        "provenance": { "evidenceIds": ["ev-conversion-def"] }
      },
      {
        "id": "query-a1",
        "name": "active_subscribers_snapshot",
        "sql": "SELECT COUNT(DISTINCT MEMBER_ID) FROM FACT_SUBSCRIPTION_CYCLE WHERE SUBSCRIPTION_STATE = 'active' AND IS_INTERNAL = FALSE",
        "metricIds": ["metric-active-subscribers"],
        "assetIds": ["asset-fact-cycle"],
        "evidenceIds": ["ev-cycle-catalog"],
        "signed": { "state": "signed", "history": [{ "action": "signed", "ownerId": "owner-dana", "at": "2026-07-18T09:00:00.000Z" }] },
        "provenance": { "evidenceIds": ["ev-cycle-catalog"] }
      },
      {
        "id": "query-c1",
        "name": "monthly_churn_by_cohort",
        "sql": "SELECT month, cancels / actives_at_start AS churn FROM churn_cohort WHERE IS_INTERNAL = FALSE",
        "metricIds": ["metric-churn"],
        "assetIds": ["asset-fact-cycle"],
        "evidenceIds": ["ev-cycle-catalog"],
        "signed": { "state": "signed", "history": [{ "action": "signed", "ownerId": "owner-dana", "at": "2026-07-18T09:00:00.000Z" }] },
        "provenance": { "evidenceIds": ["ev-cycle-catalog"] }
      }
    ],
    "caveats": [
      {
        "id": "caveat-internal",
        "name": "Internal/staff accounts skew everything",
        "severity": "CORRECTION",
        "where": [{ "kind": "column", "assetId": "asset-dim-member", "columnId": "col-member-internal" }],
        "what": "~1,900 staff and QA accounts have unlimited plans and abnormal usage.",
        "action": "Always filter IS_INTERNAL = FALSE; say you did.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-warehouse",
        "evidenceIds": ["ev-member-catalog"],
        "provenance": { "evidenceIds": ["ev-member-catalog"] }
      },
      {
        "id": "caveat-trialing",
        "name": "Trials are not subscribers",
        "severity": "CORRECTION",
        "where": [{ "kind": "column", "assetId": "asset-fact-cycle", "columnId": "col-cycle-state" }],
        "what": "'trialing' rows look like subscriptions but no payment has occurred.",
        "action": "Exclude 'trialing' from subscriber counts unless the question is about trials.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-warehouse",
        "evidenceIds": ["ev-cycle-catalog"],
        "provenance": { "evidenceIds": ["ev-cycle-catalog"] }
      },
      {
        "id": "caveat-pause",
        "name": "A pause is not a churn",
        "severity": "CORRECTION",
        "where": [{ "kind": "column", "assetId": "asset-fact-cycle", "columnId": "col-cycle-state" }],
        "what": "Paused members stop paying but haven't cancelled; counting pauses as churn overstates it.",
        "action": "Churn counts only 'cancelled'. Report pauses separately if asked.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-warehouse",
        "evidenceIds": ["ev-cycle-catalog"],
        "provenance": { "evidenceIds": ["ev-cycle-catalog"] }
      },
      {
        "id": "caveat-active-ambiguity",
        "name": "'Active' means two different things",
        "severity": "BLOCKER",
        "where": [{ "kind": "metric", "metricId": "metric-active-subscribers" }, { "kind": "metric", "metricId": "metric-active-minutes" }],
        "what": "'active' can mean paying (subscriber) or engaged (using the app). They diverge a lot.",
        "action": "Stop and ask which one before answering any 'how many active...' question.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-brief",
        "evidenceIds": ["ev-brief"],
        "provenance": { "evidenceIds": ["ev-brief"] }
      },
      {
        "id": "caveat-subminute",
        "name": "Sub-minute sessions are accidental opens",
        "severity": "CORRECTION",
        "where": [{ "kind": "column", "assetId": "asset-fact-session", "columnId": "col-session-duration" }],
        "what": "~8% of sessions are under 60s — app opened and closed, not real usage.",
        "action": "Exclude SESSION_DURATION_SECONDS < 60 from engagement metrics.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-warehouse",
        "evidenceIds": ["ev-session-catalog"],
        "provenance": { "evidenceIds": ["ev-session-catalog"] }
      },
      {
        "id": "caveat-plan-tier",
        "name": "Plan tier is a code, not a name",
        "severity": "NOTE",
        "where": [{ "kind": "column", "assetId": "asset-dim-member", "columnId": "col-member-plan" }],
        "what": "PLAN_TIER is an integer (1=monthly, 2=annual, 3=family), not a label.",
        "action": "Map the code; never filter on a plan name string — there isn't one.",
        "foundAt": "2026-07-17",
        "foundSourceId": "source-warehouse",
        "evidenceIds": ["ev-member-catalog"],
        "provenance": { "evidenceIds": ["ev-member-catalog"] }
      }
    ],
