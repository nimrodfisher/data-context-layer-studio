        "status": "draft",
        "description": "Share of trials that become paying subscribers, by trial-start cohort.",
        "workedExample": "June cohort: 1,820 paid / 8,400 trials started = 21.7%.",
        "definition": { "kind": "expression", "expression": "paid_conversions / trials_started, by trial-start cohort" },
