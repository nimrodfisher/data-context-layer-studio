        "status": "draft",
        "description": "Total in-app active minutes per member over a period (engaged, not subscribed).",
        "workedExample": "July, active members: median 92 active minutes.",
        "definition": { "kind": "sql", "sql": "SUM(SESSION_DURATION_SECONDS)/60 WHERE SESSION_DURATION_SECONDS >= 60" },
