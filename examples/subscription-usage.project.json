        "workedExample": "2026-07-15 snapshot: 46,900 active subscribers.",
        "definition": { "kind": "sql", "sql": "COUNT(DISTINCT MEMBER_ID) WHERE SUBSCRIPTION_STATE = 'active' AND IS_INTERNAL = FALSE" },
        "accessModifier": "internal",
        "assetIds": ["asset-fact-cycle"],
